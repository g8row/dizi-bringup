From 07b7820c1c66fd7b40377aaad24f193cc02996ad Mon Sep 17 00:00:00 2001
From: Alexander Gurov <alexander.gurov@konsulko.com>
Date: Mon, 28 Sep 2026 12:37:56 +0300
Subject: [PATCH] releasetools: accept a ZipFile in PartitionMapFromTargetFiles

LoadInfoDict on a target-files zip (sign_target_files_apks) reaches
_ReadPartitionPropFile, which passed the ZipFile to os.path.join and
crashed with a TypeError. Look the partition subdirs up in the zip's
name list instead.

Claude-Session: https://claude.ai/code/session_01YZrxbgb9k1nNzQwMqEHGyo
---
 tools/releasetools/common.py | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/tools/releasetools/common.py b/tools/releasetools/common.py
index 47ab9e7..8c45802 100644
--- a/tools/releasetools/common.py
+++ b/tools/releasetools/common.py
@@ -1364,7 +1364,7 @@ def MergeDynamicPartitionInfoDicts(framework_dict, vendor_dict):
 
 
 def PartitionMapFromTargetFiles(target_files_dir):
-  """Builds a map from partition -> path within an extracted target files directory."""
+  """Builds a map from partition -> path within target files (a directory or ZipFile)."""
   # Keep possible_subdirs in sync with build/make/core/board_config.mk.
   possible_subdirs = {
       "system": ["SYSTEM"],
@@ -1379,9 +1379,15 @@ def PartitionMapFromTargetFiles(target_files_dir):
       "system_dlkm": ["SYSTEM_DLKM", "SYSTEM/system_dlkm"],
   }
   partition_map = {}
+  if isinstance(target_files_dir, zipfile.ZipFile):
+    names = target_files_dir.namelist()
+    exists = lambda subdir: any(n.startswith(subdir + "/") for n in names)
+  else:
+    exists = lambda subdir: os.path.exists(
+        os.path.join(target_files_dir, subdir))
   for partition, subdirs in possible_subdirs.items():
     for subdir in subdirs:
-      if os.path.exists(os.path.join(target_files_dir, subdir)):
+      if exists(subdir):
         partition_map[partition] = subdir
         break
   return partition_map
-- 
